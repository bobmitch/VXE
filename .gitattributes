# Normalise to LF in the repository; check out native on each platform.
* text=auto

# Always LF — these are run by shells.
*.sh text eol=lf

# Always CRLF — Windows tooling.
*.bat text eol=crlf
*.cmd text eol=crlf

# Source
*.c     text diff=cpp
*.cpp   text diff=cpp
*.h     text diff=cpp
*.hpp   text diff=cpp
*.hlsl  text
*.hlsli text
*.cmake text
*.md    text diff=markdown
